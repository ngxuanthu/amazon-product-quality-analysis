          </datasources>
          <datasource-dependencies datasource='federated.0keldpm1hdv3kb1an4li81u383gh'>
            <column caption='1 star' datatype='real' default-format='p0.00%' name='[Calculation_1049476318224385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([review_count] * [one_star_pct])&#10;/&#10;SUM([review_count])&#10;/&#10;100' />
            </column>
            <column caption='2 stars' datatype='real' default-format='p0.00%' name='[Calculation_1049476318265346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([review_count] * [two_star_pct]) / SUM([review_count]) / 100' />
            </column>
            <column caption='3 stars' datatype='real' default-format='p0.00%' name='[Calculation_1049476318322691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([review_count] * [three_star_pct]) / SUM([review_count]) / 100' />
            </column>
            <column caption='4 stars' datatype='real' default-format='p0.00%' name='[Calculation_1049476318363652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([review_count] * [four_star_pct]) / SUM([review_count]) / 100' />
            </column>
            <column caption='5 stars' datatype='real' default-format='p0.00%' name='[Calculation_1049476318441478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([review_count] * [five_star_pct]) / SUM([review_count]) / 100' />
